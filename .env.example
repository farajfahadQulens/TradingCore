# Capital.com credentials – required for live trading
CAPITAL_API_KEY=YOUR_API_KEY_HERE
CAPITAL_USERNAME=YOUR_USERNAME_HERE
CAPITAL_PASSWORD=YOUR_PASSWORD_HERE
ENVIRONMENT=live
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/trading
LOG_LEVEL=INFO
BROKER_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
REDIS_URL=redis://localhost:6379/0
ALLOW_LIVE_TRADING=false
